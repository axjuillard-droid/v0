# ──────────────────────────────────────────────────────────
# Configuration du Catalogue NAS pour serveur entreprise
# ──────────────────────────────────────────────────────────

# ── BASE DE DONNÉES ────────────────────────────────────────
# URL de connexion à votre serveur PostgreSQL d'entreprise :
# Format : postgresql://utilisateur:motdepasse@hote_ou_ip_postgres:5432/nom_de_la_base
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nas_catalog

# ── RÉSEAU / SERVEUR ───────────────────────────────────────
PORT=5000
HOST=0.0.0.0

# ── URL PUBLIQUE (pour le .cfg/.bat distribués aux clients) ───────────────
# IMPORTANT : à renseigner impérativement en production (Docker / reverse proxy).
# C'est l'URL que les utilisateurs saisiront dans scan_nas.exe / scan_nas.bat.
# Si vide, le serveur tente une détection automatique via les headers proxy.
#
# Exemples :
#   PUBLIC_URL=https://catalogue-nas.entreprise.local
#   PUBLIC_URL=https://mon-serveur.local/apps/catalogue
#
# PUBLIC_URL=

# ── OPTIONS ───────────────────────────────────────────────
# Désactiver l'ouverture automatique du navigateur (recommandé pour Docker)
NO_BROWSER=true

# Nombre de workers Tornado (0 = auto selon les CPU, 1 = mode mono-processus)
WORKERS=1

# Taille max des paquets JSON d'indexation en octets (50 Mo par défaut)
MAX_BODY_SIZE=52428800

# Nombre max de connexions SQL simultanées dans le pool
DB_THREAD_POOL_MAX=16
